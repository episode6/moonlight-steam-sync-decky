{
  "name": "moonlight-steam-sync-decky",
  "version": "0.3.3",
  "description": "Moonlight Sync: a Decky plugin that runs moonlight-steam-sync from Game Mode.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "episode6, Inc.",
  "moonlightSteamSync": "0.4.0",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "python3 scripts/package.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/episode6/moonlight-steam-sync-decky.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "moonlight"
  ],
  "bugs": {
    "url": "https://github.com/episode6/moonlight-steam-sync-decky/issues"
  },
  "homepage": "https://github.com/episode6/moonlight-steam-sync-decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@eslint/js": "^9.39.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/node": "^22.20.4",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "@decky/ui": "^4.11.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
