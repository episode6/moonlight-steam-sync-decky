{
  "name": "steam-input-probe",
  "version": "0.0.1",
  "description": "Throwaway Decky plugin that probes the undocumented Steam client APIs the Moonlight Sync plugin depends on (spec PR-0, probes V1-V5).",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "episode6, Inc.",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit"
  },
  "packageManager": "pnpm@9.15.9",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
